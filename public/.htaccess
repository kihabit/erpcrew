<IfModule mod_rewrite.c>

    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /


    # Redirect www to non-www
    RewriteCond %{HTTP_HOST} ^www\.erpcrew\.ai$ [NC]
    RewriteRule ^(.*)$ https://uat.erpcrew.ai/$1 [R=301,L]
    
    # Force HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://uat.erpcrew.ai/$1 [R=301,L]
    # ==========================================================
    # MAIN PRODUCTION WEBSITE
    # ==========================================================


    # ----------------------------------------------------------
    # Authorization
    # ----------------------------------------------------------

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]


    # ----------------------------------------------------------
    # XSRF
    # ----------------------------------------------------------

    RewriteCond %{HTTP:X-XSRF-TOKEN} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-TOKEN}]


    # ----------------------------------------------------------
    # Laravel / Filament / Livewire / API
    # ----------------------------------------------------------

    RewriteCond %{REQUEST_URI} ^/(admin|api|sanctum|livewire-[^/]+)(/|$) [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]


    # ----------------------------------------------------------
    # Existing physical files
    # ----------------------------------------------------------

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

</IfModule>

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/mr0nmxzvz5ba/public_html/uat.erpcrew.ai/frontend"
PassengerBaseURI "/"
PassengerNodejs "/home/mr0nmxzvz5ba/nodevenv/public_html/uat.erpcrew.ai/frontend/24/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
